#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=false
if [[ "${1:-}" == "--dry-run" ]]; then
  DRY_RUN=true
  shift
fi

VERSION=${1:-}

if [[ -z "$VERSION" ]]; then
  echo "Usage: bin/release [--dry-run] VERSION"
  echo "Example: bin/release 0.2.0"
  exit 1
fi

if [[ -n $(git status --porcelain) ]]; then
  echo "Error: Working directory not clean. Commit or stash changes first."
  exit 1
fi

BUILD_FILE="purchasekit/build.gradle.kts"
VERSION_FILE="purchasekit/src/main/java/dev/purchasekit/android/Version.kt"

CURRENT_VERSION=$(grep -o 'version = "[^"]*"' "$BUILD_FILE" | head -1 | cut -d'"' -f2)

if [[ "$CURRENT_VERSION" == "$VERSION" ]]; then
  echo "Error: Version is already $VERSION"
  exit 1
fi

if [[ "$DRY_RUN" == true ]]; then
  echo "android/: $CURRENT_VERSION -> $VERSION"
  exit 0
fi

# Update build.gradle.kts
sed -i '' "s/version = \"$CURRENT_VERSION\"/version = \"$VERSION\"/" "$BUILD_FILE"

# Update Version.kt
sed -i '' "s/PURCHASEKIT_VERSION = \".*\"/PURCHASEKIT_VERSION = \"$VERSION\"/" "$VERSION_FILE"

# Commit version bump
git add "$BUILD_FILE" "$VERSION_FILE"
git commit -m "Bump version to $VERSION"

# Tag with version
git tag "$VERSION"

# Push to git + tags
git push origin main
git push origin "$VERSION"

echo "Released PurchaseKit Android v$VERSION"
